# Sao thành .env (chạy ở máy) hoặc đặt trên Vercel → Settings → Environment Variables.

# ── Bắt buộc ─────────────────────────────────────────────────────────────────
BOT_TOKEN=                      # token bot Telegram (BotFather)
OWNER_ID=                       # Telegram user id của chủ bot (người duyệt người nhà)
TELEGRAM_WEBHOOK_SECRET=        # chuỗi bí mật tự đặt, dùng khi setWebhook (secret_token)
CRON_SECRET=                    # chuỗi bí mật tự đặt, Vercel Cron gửi Authorization: Bearer <CRON_SECRET>
ANTHROPIC_API_KEY=              # khoá Claude API (platform.claude.com); model đặt bằng CLAUDE_MODEL
TURSO_DATABASE_URL=             # libsql://... — cất token Garmin, danh sách người dùng, sổ cân, bản tin đệm
TURSO_AUTH_TOKEN=

# ── Chủ bot (không có thì Mia gọi "bạn", xưng "mình", hồ sơ trống) ───────────
CHU_TEN=anh Alex                # cách Mia nhắc tới chủ với người khác: "Mia đã báo anh Alex duyệt"
CHU_GOI=ba                      # Mia gọi chủ là gì
CHU_XUNG=con                    # Mia xưng gì với chủ
# Hồ sơ thực đơn / cân nặng của chủ (JSON một dòng). kcal_min/kcal_max/dam_min/dam_uu_tien là tuỳ chọn:
# không đặt thì tính theo giới tính + cân + mục tiêu như mọi người.
CHU_HO_SO={"gioi_tinh":"nam","cao_cm":172,"muc_tieu_kg":68,"an_sang":0,"an_uong":"gà, bò, cá hồi","tin_thoi_su":1,"tin_xa_hoi":0,"tin_cong_nghe":1,"thuc_don":1}
CHU_CAN_BAT_DAU=2026-09-19,76   # mốc cân bắt đầu của chủ (ngày,kg) — bỏ trống thì lấy lần cân đầu tiên

# ── Tuỳ chọn ─────────────────────────────────────────────────────────────────
HOI_MOI_NGAY=30                 # số câu hỏi tự do mỗi người mỗi ngày (chủ bot không giới hạn)
ANH_MOI_NGAY=12                 # số ảnh bữa ăn mỗi người mỗi ngày
DUYET_TAY=0                     # 1 = người mới phải chờ chủ bot duyệt; 0/bỏ trống = ai vào cũng dùng ngay
MIA_URL=https://<project>.vercel.app/api/app   # địa chỉ Mini App (nút "Mở Mia")
CLAUDE_MODEL=claude-opus-5-5   # hoặc claude-sonnet-5-5 / claude-haiku-5-5 cho rẻ hơn
CLAUDE_EFFORT=low               # low | medium | high — việc ở đây là tóm tắt số liệu, low là đủ
VGSNEWS_URL=https://news.alexvgs.tech/tin.json?limit=30   # nguồn tin công nghệ (JSON {"articles":[{title,digest,url,ts}]})
MAN_PHU_KEY=                    # khoá đọc /api/man_phu (dashboard riêng), bỏ trống thì cổng này trả 401
BAO_CAO_SECRET=                 # phần riêng VGS (báo cáo game Đấu Trường PC) — bỏ trống thì tắt
BAO_CAO_URL=https://vgs.zone/api/bao-cao-ngay
